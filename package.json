{
  "name": "portfolio-website",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:ip": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "preview": "next start --hostname 127.0.0.1 --port 3000",
    "preview:e2e": "next start --hostname 127.0.0.1 --port 3101",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze:unused": "knip --config knip.json --no-exit-code",
    "analyze:unused:strict": "knip --config knip.json",
    "analyze:unused:json": "knip --config knip.json --reporter json --no-exit-code > ./test-results/knip-report.json",
    "analyze:style-boundary": "node ./scripts/analyze-style-boundary.mjs",
    "analyze:style-boundary:strict": "node ./scripts/analyze-style-boundary.mjs --strict",
    "analyze:style-boundary:changed": "node ./scripts/analyze-style-boundary.mjs --changed",
    "analyze:style-boundary:changed:strict": "node ./scripts/analyze-style-boundary.mjs --changed --strict",
    "analyze:clean-code": "pnpm run analyze:unused && pnpm run analyze:style-boundary",
    "analyze:clean-code:strict": "pnpm run analyze:unused:strict && pnpm run analyze:style-boundary:strict",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:baseline": "playwright test tests/e2e/smoke.spec.ts tests/e2e/navigation.spec.ts tests/e2e/seo.spec.ts",
    "test:e2e:baseline:ci": "mkdir -p ./test-results && playwright test tests/e2e/smoke.spec.ts tests/e2e/navigation.spec.ts tests/e2e/seo.spec.ts --reporter=json > ./test-results/playwright-baseline.json",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "perf:lighthouse": "pnpm run perf:lighthouse:desktop && pnpm run perf:lighthouse:mobile",
    "perf:lighthouse:desktop": "start-server-and-test \"pnpm run preview\" http://127.0.0.1:3000 \"node ./scripts/run-lighthouse.mjs desktop\"",
    "perf:lighthouse:mobile": "start-server-and-test \"pnpm run preview\" http://127.0.0.1:3000 \"node ./scripts/run-lighthouse.mjs mobile\"",
    "perf:lighthouse:baseline": "pnpm run build && pnpm run perf:lighthouse && node ./scripts/verify-lighthouse-thresholds.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "0.575.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "schema-dts": "^2.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "lighthouse": "^12.8.2",
    "playwright": "1.65.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "start-server-and-test": "^3.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.14.0"
}
