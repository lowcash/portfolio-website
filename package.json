{
      "name": "personal-presentation-website",
      "version": "1.0.1",
      "type": "module",
      "dependencies": {
            "lucide-react": "^0.487.0",
            "react": "^18.3.1",
            "react-dom": "^18.3.1"
      },
      "devDependencies": {
            "@eslint/js": "^9.39.1",
            "@playwright/test": "^1.58.2",
            "@types/node": "^20.10.0",
            "@types/react": "^19.2.7",
            "@types/react-dom": "^19.2.3",
            "@vitejs/plugin-react-swc": "^3.10.2",
            "eslint": "^9.39.1",
            "eslint-plugin-react-hooks": "^7.0.1",
            "eslint-plugin-react-refresh": "^0.4.24",
            "globals": "^16.5.0",
            "knip": "^6.0.6",
            "lighthouse": "^12.8.2",
            "playwright": "1.58.2",
            "start-server-and-test": "^3.0.0",
            "typescript": "^5.9.3",
            "typescript-eslint": "^8.48.0",
            "vite": "6.3.5"
      },
      "scripts": {
            "dev": "vite",
            "dev:ip": "vite --host",
            "build": "tsc -b && vite build",
            "lint": "eslint .",
            "analyze:unused": "knip --config knip.json --no-exit-code",
            "analyze:unused:strict": "knip --config knip.json",
            "analyze:unused:json": "knip --config knip.json --reporter json --no-exit-code > ./test-results/knip-report.json",
            "analyze:style-boundary": "node ./scripts/analyze-style-boundary.mjs",
            "analyze:style-boundary:strict": "node ./scripts/analyze-style-boundary.mjs --strict",
            "analyze:style-boundary:changed": "node ./scripts/analyze-style-boundary.mjs --changed",
            "analyze:style-boundary:changed:strict": "node ./scripts/analyze-style-boundary.mjs --changed --strict",
            "analyze:clean-code": "npm run analyze:unused && npm run analyze:style-boundary",
            "analyze:clean-code:strict": "npm run analyze:unused:strict && npm run analyze:style-boundary:strict",
            "preview": "vite preview",
            "test:e2e": "playwright test",
            "test:e2e:headed": "playwright test --headed",
            "test:e2e:debug": "playwright test --debug",
            "perf:lighthouse:desktop": "start-server-and-test \"npm run dev -- --host 127.0.0.1 --port 3000\" http://127.0.0.1:3000 \"node ./scripts/run-lighthouse.mjs desktop\"",
            "perf:lighthouse:mobile": "start-server-and-test \"npm run dev -- --host 127.0.0.1 --port 3000\" http://127.0.0.1:3000 \"node ./scripts/run-lighthouse.mjs mobile\""
      }
}
